  "onlineTask": {
    "sourceTaskId": 22,
    "taskId": "task:hiddenbench:22",
    "publicContext": "You and three other participants are scientists at an Antarctic research station. A massive, fast-moving storm is approaching. You must rapidly decide, as a group, which facility to seek shelter in for the next 48 hours. You have snow vehicles and limited time to reach only one location before the blizzard begins. Your three choices:\n- Main Base: The largest facility, but farther away.\n- Retreat Camp: A small, nearby camp rated for storms.\n- Rescue Outpost: Smaller, medium distance, typically used for emergencies.\nWhichever location you pick, you'll be unable to contact others until the storm passes. Supplies, infrastructure, and route safety may differ. Only one option will keep you safe and supplied until rescue teams arrive.\n\nShared information:\n1. A radio update confirms Retreat Camp is the closest shelter and is built to withstand severe weather.\n2. Supply records say that Retreat Camp offers food, water, and sleeping bags for four people.\n3. The snow vehicle has just enough fuel to reach any of the three locations before the storm hits, but not to try multiple.\n4. The Rescue Outpost's exterior was recently checked and found structurally sound.",
    "claim": {
      "id": "claim:hiddenbench:22:answer",
      "proposition": "Select the single correct answer for HiddenBench task 22 (Antarctic Storm Safe Haven).",
      "domain": "hiddenbench-categorical-decision",
      "createdAt": "2026-08-11T00:00:00.000Z",
      "options": [
        "Main Base",
        "Retreat Camp",
        "Rescue Outpost"
      ],
      "resolutionPolicy": {
        "kind": "categorical",
        "resolverId": "resolver:hiddenbench-data-3be6ca16"
      }
    },
    "agents": [
      {
        "agentId": "agent:hiddenbench:22:1",
        "privateInformation": "The most recent supply delivery to Retreat Camp was delayed, so the promised food and water may not be there."
      },
      {
        "agentId": "agent:hiddenbench:22:2",
        "privateInformation": "Main Base appears to have uninterrupted generator power, working communications, and fully stocked rations according to a direct radio call just before the storm warning."
      },
      {
        "agentId": "agent:hiddenbench:22:3",
        "privateInformation": "The snow route to Rescue Outpost is fully snowed in since the last storm; the path isn't navigable even with the vehicle."
      },
      {
        "agentId": "agent:hiddenbench:22:4",
        "privateInformation": "Satellite imagery from this morning shows the ice bridge leading to Retreat Camp has collapsed, making it dangerous to reach by foot or vehicle."
      }
    ]
  },
