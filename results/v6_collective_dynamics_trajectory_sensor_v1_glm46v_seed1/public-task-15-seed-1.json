  "onlineTask": {
    "sourceTaskId": 15,
    "taskId": "task:hiddenbench:15",
    "publicContext": "A priceless ancient artifact has just been unearthed in your city. Authorities task your team with deciding where to safely store it for 24 hours until the national museum can collect it. The city is experiencing rising river levels after days of storms, and several neighborhoods have intermittent power outages. You must quickly agree on the safest location for the artifact. The options are:\n- City Bank: Modern steel vault, backup generator, but in an area at risk for power outages and flooding.\n- University Library: Centrally located, 24/7 security, and not known to flood.\n- Downtown Police Station: High security, but rumored to be crowded due to emergency shelter duties.\n\nShared information:\n1. The University Library is built on higher ground and has never experienced flooding, making it a trusted location for safe storage of rare books and documents.\n2. The City Bank's vault is rated for both fire and water, and a backup generator was recently installed.\n3. The Downtown Police Station is acting as a temporary shelter and has significantly more traffic than usual, including people seeking refuge from flooded homes.",
    "claim": {
      "id": "claim:hiddenbench:15:answer",
      "proposition": "Select the single correct answer for HiddenBench task 15 (artifact_safe_haven).",
      "domain": "hiddenbench-categorical-decision",
      "createdAt": "2026-08-11T00:00:00.000Z",
      "options": [
        "City Bank",
        "University Library",
        "Downtown Police Station"
      ],
      "resolutionPolicy": {
        "kind": "categorical",
        "resolverId": "resolver:hiddenbench-data-3be6ca16"
      }
    },
    "agents": [
      {
        "agentId": "agent:hiddenbench:15:1",
        "privateInformation": "A government memo sent to police leadership confirms that a secure evidence room—separate from the public shelter area—remains unused and can be made accessible for artifact storage immediately."
      },
      {
        "agentId": "agent:hiddenbench:15:2",
        "privateInformation": "The University Library's 24/7 security detail will be off-site for a mandatory citywide training drill tonight, and only basic staff will remain during the night."
      },
      {
        "agentId": "agent:hiddenbench:15:3",
        "privateInformation": "The road to the University Library is blocked by downed trees from the storm and will not be open for at least another 24 hours."
      },
      {
        "agentId": "agent:hiddenbench:15:4",
        "privateInformation": "Power company officials confirm that the City Bank's backup generator is due for repairs and has not functioned during recent outages."
      }
    ]
  },
