        "kind": "categorical",
        "resolverId": "resolver:hiddenbench-data-3be6ca16"
      }
    },
    "agents": [
      {
        "agentId": "agent:hiddenbench:29:1",
        "privateInformation": "Due to minor flooding on Oakcrest road, buses can only reach Riverside Park from the north side."
      },
      {
        "agentId": "agent:hiddenbench:29:2",
        "privateInformation": "A landslide warning was just issued for Summerfield's region by the National Weather Service, effective immediately."
