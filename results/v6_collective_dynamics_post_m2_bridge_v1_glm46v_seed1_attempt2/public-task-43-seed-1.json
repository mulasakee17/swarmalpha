        "resolverId": "resolver:hiddenbench-data-3be6ca16"
      }
    },
    "agents": [
      {
        "agentId": "agent:hiddenbench:43:1",
        "privateInformation": "Security personnel at Aurora Station were evacuated in the last 30 minutes due to a hazardous chemical leak."
      },
      {
        "agentId": "agent:hiddenbench:43:2",
        "privateInformation": "Beacon Post's loading bay was blocked by a landslide this morning; only Canyon Depot has an accessible loading area."
      },
      {
        "agentId": "agent:hiddenbench:43:3",
        "privateInformation": "The energy artifact requires a functioning climate control system: Aurora Station's system failed during the blackout and is still offline."
      },
      {
        "agentId": "agent:hiddenbench:43:4",
        "privateInformation": "The only bridge leading to Aurora Station was reported collapsed an hour ago by a search drone."
      }
    ]
  },
