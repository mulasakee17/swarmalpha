  "onlineTask": {
    "sourceTaskId": 57,
    "taskId": "task:hiddenbench:57",
    "publicContext": "You and three colleagues are archaeologists tasked with selecting a site to salvage crucial artifacts before construction begins. There are tight time constraints: you can only pick one location, and you must choose by the end of the hour. There are three candidate sites: Site A, Site B, and Site C. You must maximize your chances of a successful recovery, as failure means the artifacts may be lost forever.\n\nShared information:\n1. Site A: Riverbank, frequent flooding in spring, unknown artifact depth.\n2. Site B: Plateau, stable ground, topsoil is soft and undisturbed.\n3. Site C: Woods edge, soil is rocky, some evidence of rodent burrows.\n4. The main developer has announced all construction will start tomorrow, but precise order is unknown.",
    "claim": {
      "id": "claim:hiddenbench:57:answer",
      "proposition": "Select the single correct answer for HiddenBench task 57 (archaeological_dig_site).",
      "domain": "hiddenbench-categorical-decision",
      "createdAt": "2026-08-11T00:00:00.000Z",
      "options": [
        "Site A",
        "Site B",
        "Site C"
      ],
      "resolutionPolicy": {
        "kind": "categorical",
        "resolverId": "resolver:hiddenbench-data-3be6ca16"
      }
    },
    "agents": [
      {
        "agentId": "agent:hiddenbench:57:1",
        "privateInformation": "In a recent survey, Site C’s rodent burrows were found to be abandoned, with no damage to deep soil layers."
      },
      {
        "agentId": "agent:hiddenbench:57:2",
        "privateInformation": "You overheard that Site A is predicted to flood tonight due to sudden rain upstream."
      },
      {
        "agentId": "agent:hiddenbench:57:3",
        "privateInformation": "You have seen construction crews preparing explosive charges at Site B because blasting for foundations is scheduled for the morning."
      },
      {
        "agentId": "agent:hiddenbench:57:4",
        "privateInformation": "Site A’s access road is being closed off for bridge repairs overnight and won't reopen for two days."
      }
    ]
  },
